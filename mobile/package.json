{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/stack": "^7.9.3",
    "expo": "~55.0.26",
    "expo-asset": "~55.0.17",
    "expo-crypto": "~55.0.15",
    "expo-file-system": "~55.0.22",
    "expo-modules-core": "~55.0.0",
    "expo-notifications": "~55.0.23",
    "expo-secure-store": "~55.0.14",
    "expo-sqlite": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "^0.83.6",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-nitro-image": "0.15.0",
    "react-native-nitro-modules": "0.35.9",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vision-camera": "^5.0.11",
    "react-native-vision-camera-worklets": "5.0.11",
    "react-native-worklets": "0.7.4"
  },
  "publishConfig": {
    "executableFiles": [
      "./android/gradlew"
    ]
  },
  "scripts": {
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:contract": "jest --testMatch \"**/__tests__/contract/**/*.test.[jt]s?(x)\"",
    "test:perf": "jest --testMatch \"**/__tests__/perf/**/*.bench.[jt]s?(x)\" --coverage=false"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|@noble))",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "branches": 70
      }
    },
    "testMatch": [
      "**/__tests__/unit/**/*.test.[jt]s?(x)",
      "**/__tests__/integration/**/*.test.[jt]s?(x)",
      "**/__tests__/contract/**/*.test.[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/ml/modelAssets.ts",
      "!src/ml/frameProcessor.ts"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.19",
    "@types/react": "~19.2.15",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "babel-preset-expo": "~55.0.22",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.0"
  }
}

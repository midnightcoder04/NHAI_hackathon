{
  "expo": {
    "name": "NHAI Field Ops",
    "slug": "nhai-field-ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "deploymentTarget": "14.0",
      "bundleIdentifier": "com.anonymous.nhaifieldops"
    },
    "android": {
      "minSdkVersion": 26,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.nhaifieldops"
    },
    "plugins": [
      "expo-sqlite",
      "react-native-fast-tflite"
    ]
  }
}
